# Dependencies
node_modules/

# Build output (generated by `npm run build`)
frontend/dist/
dist/
.firebase/

# Backend runtime database (real user data — never commit)
backend/.backend/
.backend/
.data/

# Logs / temp
*.log
.tmp/
backups/

# Editor / OS
.DS_Store
Thumbs.db

# Secrets — the service key must never be committed. Keep it in .env.local,
# which the import command reads without it ever appearing on screen.
.env
.env.*
!.env.example

# Customer backups handed over for import — real shop data, not ours to keep in git.
import-data/
